---
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";

const screenshots = [
	{
		title: "Resumen de la actividad",
		description: "Alertas, revisiones recientes y tareas pendientes en una vista general.",
		src: "/projects/app-icultura/01-dashboard.png",
		alt: "Panel de inicio de App-icultura con resumen de colmenas, alertas, revisiones recientes y tareas pendientes",
		width: 1440,
		height: 900,
	},
	{
		title: "Conocer cada colmenar",
		description: "Consulta la distribución, la ocupación y el estado de las colmenas.",
		src: "/projects/app-icultura/02-colmenar.png",
		alt: "Vista de un colmenar con filas, colmenas y sus estados",
		width: 1440,
		height: 1117,
	},
	{
		title: "Preparar la jornada de campo",
		description: "Revisa el material recogido, lo que falta y qué debe volver al almacén.",
		src: "/projects/app-icultura/03-operativa.png",
		alt: "Jornada de campo con material cargado, faltantes y sobrantes por devolver",
		width: 1440,
		height: 1171,
	},
	{
		title: "Anticipar necesidades de stock",
		description: "Revisa consumos recientes, medias mensuales y previsiones de ruptura por artículo.",
		src: "/projects/app-icultura/05-estadisticas.png",
		alt: "Estadísticas de stock con alertas de ruptura estimada, consumo reciente y consumo medio mensual por artículo",
		width: 1440,
		height: 900,
	},
];
---

<Layout
	title="App-icultura | Caso práctico | DM Integra"
	description="Caso práctico de App-icultura: organización de colmenares, trabajo de campo, inventario y previsión de existencias."
>
	<Navbar isHome={false} />
	<main id="contenido">
		<section class="border-b border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-16">
				<a
					href="/#proyectos"
					class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 underline decoration-brand underline-offset-4"
				>
					<span aria-hidden="true">←</span> Volver a proyectos
				</a>
				<p class="mt-10 border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">Caso práctico</p>
				<h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
					App-icultura: más claridad en cada jornada
				</h1>
				<p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-600">
					Una aplicación para reunir la información de los colmenares, coordinar el trabajo de campo y anticipar las
					necesidades de materiales.
				</p>
			</div>
		</section>

		<section class="bg-white">
			<div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20">
				<div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
					<article class="border border-slate-200 bg-slate-50 p-6 sm:p-8">
						<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">El problema</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">
							Información repartida entre notas, tareas y materiales
						</h2>
						<p class="mt-4 leading-relaxed text-slate-600">
							Cuando revisiones, trabajos pendientes y existencias se anotan por separado, cuesta conocer el estado de
							cada colmena, preparar cada salida y saber qué hace falta reponer.
						</p>
						<p class="mt-3 leading-relaxed text-slate-600">
							La información dispersa también dificulta consultar el consumo y entender cómo se distribuyen los gastos
							de la actividad.
						</p>
					</article>

					<article class="border border-slate-200 bg-white p-6 sm:p-8">
						<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">La solución implementada</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">
							Una vista conectada del campo y los recursos
						</h2>
						<p class="mt-4 leading-relaxed text-slate-600">
							App-icultura centraliza el seguimiento de colmenares y revisiones, la planificación y carga de jornadas,
							el control del stock y las estadísticas de consumo y gasto.
						</p>
						<ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-700">
							<li><strong class="font-semibold text-slate-900">Campo:</strong> registra revisiones y consulta el estado de cada colmena.</li>
							<li><strong class="font-semibold text-slate-900">Jornadas:</strong> prepara materiales, anota faltantes y devuelve sobrantes al almacén.</li>
							<li><strong class="font-semibold text-slate-900">Existencias:</strong> revisa consumos y alertas para anticipar posibles rupturas de stock.</li>
							<li><strong class="font-semibold text-slate-900">Costes:</strong> consulta gastos y consumo por artículo.</li>
						</ul>
					</article>
				</div>

				<aside class="mt-8 border-l-4 border-brand bg-slate-100 p-6 sm:p-8">
					<h2 class="text-xl font-semibold tracking-tight text-slate-900">Un enfoque útil más allá de la apicultura</h2>
					<p class="mt-3 max-w-4xl leading-relaxed text-slate-600">
						La misma lógica de organizar trabajo de campo, recursos y trazabilidad puede aplicarse a otros procesos
						operativos: tener tareas, movimientos y necesidades visibles facilita dar seguimiento y decidir qué hacer
						después.
					</p>
				</aside>

				<section class="mt-14" aria-labelledby="app-icultura-gallery-title">
					<div class="max-w-2xl">
						<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">La aplicación en uso</p>
						<h2 id="app-icultura-gallery-title" class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">
							Capturas del trabajo diario
						</h2>
						<p class="mt-3 leading-relaxed text-slate-600">
							Abre cualquier captura para verla a tamaño original y leer todos sus detalles.
						</p>
					</div>

					<div class="mt-7 grid gap-6 md:grid-cols-2">
						{
							screenshots.map((screenshot) => (
								<figure class="overflow-hidden border border-slate-200 bg-white">
									<a
										href={screenshot.src}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Abrir captura de ${screenshot.title} a tamaño original en una pestaña nueva`}
									>
										<img
											src={screenshot.src}
											alt={screenshot.alt}
											width={screenshot.width}
											height={screenshot.height}
											loading="lazy"
											decoding="async"
											class="block h-auto w-full"
										/>
									</a>
									<figcaption class="border-t border-slate-200 p-5 sm:p-6">
										<h3 class="font-semibold text-slate-900">{screenshot.title}</h3>
										<p class="mt-2 text-sm leading-relaxed text-slate-600">{screenshot.description}</p>
										<a
											href={screenshot.src}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Abrir captura de ${screenshot.title} a tamaño original en una pestaña nueva`}
											class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 underline decoration-brand underline-offset-4"
										>
											Abrir captura a tamaño original <span aria-hidden="true">↗</span>
										</a>
									</figcaption>
								</figure>
							))
						}
					</div>
					<p class="mt-5 text-sm font-medium text-slate-700">Capturas reales de la aplicación con datos ficticios.</p>
				</section>

				<section class="mt-14 border-y border-brand bg-slate-100 px-6 py-8 text-slate-900 sm:px-8 sm:py-10" aria-labelledby="app-icultura-cta-title">
					<h2 id="app-icultura-cta-title" class="max-w-2xl text-2xl font-semibold tracking-tight sm:text-3xl">
						¿Tienes tareas, recursos o trabajo de campo que te gustaría coordinar mejor?
					</h2>
					<p class="mt-3 max-w-2xl leading-relaxed text-slate-700">
						Explica qué proceso quieres mejorar y consulta las opciones para abordarlo.
					</p>
					<a
						href="/#contacto"
						class="mt-6 inline-flex items-center gap-2 border border-brand bg-brand px-5 py-3 text-sm font-semibold text-slate-900 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
					>
						Contactar
					</a>
				</section>
			</div>
		</section>
	</main>
	<Footer isHome={false} />
</Layout>
