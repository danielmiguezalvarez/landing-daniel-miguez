---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Aviso legal | DM Integra" description="Datos identificativos y contacto de DM Integra.">
	<main id="contenido" class="mx-auto max-w-4xl px-5 py-12 sm:px-6 sm:py-16">
		<a href="/" class="text-sm font-medium text-brand underline underline-offset-2 hover:text-brand-hover">
			Volver a DM Integra
		</a>
		<h1 class="mt-8 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Aviso legal</h1>

		<section class="mt-8 space-y-4 text-base leading-relaxed text-slate-700">
			<h2 class="text-xl font-semibold text-slate-900">Titular del sitio</h2>
			<p><strong>Nombre:</strong> Daniel Míguez Álvarez (persona física).</p>
			<p><strong>Nombre comercial:</strong> DM Integra.</p>
			<p>
				<strong>Contacto:</strong>
				<a class="font-medium text-brand underline underline-offset-2 hover:text-brand-hover" href="mailto:contacto@dmintegra.es">contacto@dmintegra.es</a>.
			</p>
			<p><strong>Sitio web:</strong> <a class="font-medium text-brand underline underline-offset-2 hover:text-brand-hover" href="https://dmintegra.es">https://dmintegra.es</a>.</p>
		</section>
	</main>
	<Footer />
</Layout>
