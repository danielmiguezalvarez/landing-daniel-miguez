---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "DM Integra | Desarrollo web, software y automatización",
	description = "Soluciones tecnológicas a medida para empresas: desarrollo web, software, automatización e integración de dispositivos.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f8f5" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-slate-50 font-sans text-slate-900 antialiased">
		<a href="#contenido" class="sr-only z-[100] rounded-lg bg-white px-4 py-3 text-sm font-semibold text-brand focus:not-sr-only focus:fixed focus:left-4 focus:top-4">
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
