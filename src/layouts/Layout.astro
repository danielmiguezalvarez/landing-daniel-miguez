---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "DM Integra | Desarrollo web, software y automatización",
	description = "Soluciones tecnológicas a medida para empresas: desarrollo web, software, automatización e integración de dispositivos.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 font-sans text-slate-900 antialiased">
		<a href="#contenido" class="sr-only z-[100] border border-brand bg-white px-4 py-3 text-sm font-semibold text-slate-900 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
