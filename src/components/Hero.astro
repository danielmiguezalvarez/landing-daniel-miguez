---
import { whatsappUrl } from "../consts";
---

<section id="inicio" class="relative overflow-hidden">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(6,78,59,0.07),transparent_58%)]"
		aria-hidden="true"
	>
	</div>
	<div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28 lg:py-36">
		<p class="mb-5 text-sm font-medium tracking-wide text-forest">
			Software a medida · Automatización de procesos · Domótica
		</p>
		<h1 class="max-w-3xl text-4xl font-semibold leading-[1.12] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
			Automatiza tareas repetitivas y gana control sobre tu negocio o vivienda
		</h1>
		<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
			Sistemas de gestión interna, portales de reservas y domótica real conectados a tu día a día. Sin cuotas de
			programas genéricos ni complicaciones técnicas.
		</p>
		<div class="mt-10">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-[#1FA855] px-6 py-3.5 text-base font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#198C46] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#198C46] sm:w-auto"
			>
				<svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z" />
				</svg>
				Cuéntame qué necesitas automatizar
			</a>
			<p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-500">
				Trato directo · Proyectos en remoto o presenciales · Presupuesto cerrado sin compromiso
			</p>
		</div>
	</div>
</section>
