---
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden">
	<div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1fr_0.92fr] lg:gap-16 lg:py-28">
		<div class="relative z-10">
			<p class="mb-6 border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">
				Desarrollo web, software y automatización
			</p>
			<h1 class="max-w-3xl text-5xl font-semibold leading-[1.04] tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
				Tecnología a medida para que tu negocio funcione mejor.
			</h1>
			<p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-700 sm:text-xl">
				Webs, software y automatizaciones para empresas que quieren trabajar mejor: desde una página profesional hasta sistemas que conectan aplicaciones, procesos y dispositivos.
			</p>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				<a
					href="#contacto"
					class="inline-flex w-full items-center justify-center border border-brand bg-brand px-6 py-3.5 text-base font-semibold text-slate-900 transition-colors duration-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
				>
					Contactar
				</a>
				<a
					href="#proyectos"
					class="inline-flex w-full items-center justify-center border border-slate-300 px-6 py-3.5 text-base font-semibold text-slate-900 transition-colors duration-300 hover:border-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
				>
					Ver proyectos
				</a>
			</div>
		</div>
		<figure class="relative mx-auto w-full max-w-2xl">
			<div class="absolute -left-4 top-0 h-full w-1 bg-brand" aria-hidden="true"></div>
			<a
				href="/proyectos/app-icultura"
				class="relative block border border-slate-200 bg-slate-100 p-3 transition-colors duration-300 hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand sm:p-4"
				aria-label="Ver el caso práctico de App-icultura"
			>
				<img
					src="/projects/app-icultura/02-colmenar.png"
					alt="Vista de App-icultura con la distribución y el estado de las colmenas"
					width="1440"
					height="1117"
					fetchpriority="high"
					class="block h-auto w-full"
				/>
				<figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-2 border-t border-slate-200 px-2 pt-3">
					<span class="text-xl font-semibold text-slate-900">App-icultura</span>
					<span class="text-sm text-slate-600">Captura real · datos ficticios</span>
				</figcaption>
			</a>
		</figure>
	</div>
</section>
