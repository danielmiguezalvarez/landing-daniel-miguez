---
const whatsappUrl = "https://wa.me/34000000000";
---

<section id="inicio" class="relative overflow-hidden">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(12,79,92,0.09),transparent_58%)]"
		aria-hidden="true"
	>
	</div>
	<div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28 lg:py-36">
		<p class="mb-5 text-sm font-medium tracking-wide text-petrol">Vigo · Galicia</p>
		<h1 class="max-w-3xl text-4xl font-semibold leading-[1.12] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
			Software a medida y automatización para negocios locales
		</h1>
		<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
			Sustituye los Excel y las tareas manuales por sistemas que trabajan por ti 24/7: desde reservas online hasta
			apertura automática de puertas y luces
		</p>
		<div class="mt-10">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-petrol px-6 py-3.5 text-base font-medium text-white shadow-sm transition-colors hover:bg-petrol-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol sm:w-auto"
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M20.5 3.5A11 11 0 0 0 2.1 16.7L1 23l6.5-1.1A11 11 0 0 0 20.5 3.5Zm-8.5 17a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-3.9.6.7-3.8-.2-.3A9.1 9.1 0 1 1 12 20.5Zm5-6.8c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.2-.3a.5.5 0 0 0 0-.5c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4.1 5.3 5.3 0 0 0 3.2.7 2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.6-.3Z"
					></path>
				</svg>
				Cuéntame tu idea por WhatsApp
			</a>
		</div>
	</div>
</section>
