---
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden">
	<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(22,113,60,0.09),transparent_58%)]" aria-hidden="true"></div>
	<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-28">
		<div>
			<p class="mb-5 text-sm font-medium tracking-wide text-brand">Tecnología para empresas</p>
			<h1 class="max-w-3xl text-4xl font-semibold leading-[1.12] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
				Tecnología a medida para hacer crecer tu negocio.
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
				Desarrollo web, software y automatización para empresas que quieren trabajar mejor. Desde una página web
				profesional hasta sistemas que conectan aplicaciones, procesos y dispositivos físicos.
			</p>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
			<a
				href="#contacto"
				class="inline-flex w-full items-center justify-center rounded-full bg-brand px-6 py-3.5 text-base font-medium text-white shadow-sm transition-colors hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
			>
				Cuéntame tu proyecto
			</a>
				<a
					href="#servicios"
					class="inline-flex w-full items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3.5 text-base font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
				>
					Ver servicios
				</a>
			</div>
		</div>
		<div class="relative mx-auto w-full max-w-lg" aria-hidden="true">
			<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-8">
				<div class="flex items-center justify-between border-b border-slate-100 pb-5">
					<p class="text-sm font-semibold text-slate-900">Una solución conectada</p>
					<span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-800">A tu medida</span>
				</div>
				<div class="relative grid grid-cols-3 gap-3 py-8">
					<div class="absolute left-[17%] right-[17%] top-1/2 h-px bg-slate-200"></div>
					<div class="relative flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-2 py-5 text-center">
						<span class="flex size-11 items-center justify-center rounded-xl bg-white text-brand shadow-sm">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
								<rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" stroke-linecap="round" />
							</svg>
						</span>
						<span class="text-xs font-medium text-slate-700 sm:text-sm">Web</span>
					</div>
					<div class="relative flex flex-col items-center gap-3 rounded-2xl border border-brand/20 bg-brand/5 px-2 py-5 text-center">
						<span class="flex size-11 items-center justify-center rounded-xl bg-white text-brand shadow-sm">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
								<rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h8M8 13h5m-5 4h8" stroke-linecap="round" />
							</svg>
						</span>
						<span class="text-xs font-medium text-slate-700 sm:text-sm">Software</span>
					</div>
					<div class="relative flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-2 py-5 text-center">
						<span class="flex size-11 items-center justify-center rounded-xl bg-white text-brand shadow-sm">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
								<rect x="5" y="5" width="14" height="14" rx="3" /><path d="M9 9h6v6H9zM9 1v4m6-4v4M9 19v4m6-4v4M1 9h4m-4 6h4m14-6h4m-4 6h4" stroke-linecap="round" />
							</svg>
						</span>
						<span class="text-xs font-medium text-slate-700 sm:text-sm">IoT</span>
					</div>
				</div>
				<p class="text-center text-sm leading-relaxed text-slate-500">
					Páginas, procesos y dispositivos que resuelven necesidades concretas de tu negocio.
				</p>
			</div>
			<div class="absolute -bottom-4 -left-3 -z-10 size-24 rounded-3xl bg-brand/10 sm:-left-5 sm:size-32"></div>
		</div>
	</div>
</section>
