---
import { contact } from "../data/contact";
import logo from "../assets/dm-integra-logo.png";

interface Props {
	isHome?: boolean;
}

const { isHome = true } = Astro.props;
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3.5 sm:px-6 sm:py-4">
		<a href={sectionHref("inicio")} class="shrink-0" aria-label="DM Integra, inicio">
			<img src={logo.src} alt="DM Integra" width="1559" height="326" class="h-6 w-auto sm:h-8" />
		</a>
		<nav aria-label="Navegación principal" class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
			<a href={sectionHref("inicio")} class="underline-offset-4 hover:underline decoration-brand">Inicio</a>
			<a href={sectionHref("servicios")} class="underline-offset-4 hover:underline decoration-brand">Servicios</a>
			<a href={sectionHref("proyectos")} class="underline-offset-4 hover:underline decoration-brand">Proyectos</a>
			<a href={sectionHref("contacto")} class="underline-offset-4 hover:underline decoration-brand">Contacto</a>
		</nav>
		<div class="flex shrink-0 items-center gap-2">
			<details data-mobile-menu class="relative md:hidden">
				<summary class="cursor-pointer list-none border border-slate-200 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
					Menú
				</summary>
				<nav aria-label="Navegación móvil" class="absolute right-0 top-full z-10 mt-2 flex min-w-44 flex-col gap-1 border border-slate-200 bg-white p-2 text-sm font-medium text-slate-700">
					<a href={sectionHref("inicio")} class="px-3 py-2 hover:bg-slate-100">Inicio</a>
					<a href={sectionHref("servicios")} class="px-3 py-2 hover:bg-slate-100">Servicios</a>
					<a href={sectionHref("proyectos")} class="px-3 py-2 hover:bg-slate-100">Proyectos</a>
					<a href={sectionHref("contacto")} class="px-3 py-2 hover:bg-slate-100">Contacto</a>
				</nav>
			</details>
			<a
				href={contact.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Contactar por WhatsApp"
				class="inline-flex items-center justify-center border border-brand bg-brand px-3.5 py-2 text-sm font-semibold text-slate-900 transition-colors duration-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:px-4"
			>
				<span>Contactar</span>
			</a>
		</div>
	</div>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu.open = false;
		});
	});
</script>
