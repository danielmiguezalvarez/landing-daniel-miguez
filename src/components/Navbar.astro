---
import { contact } from "../data/contact";
import logo from "../assets/dm-integra-logo.png";

interface Props {
	isHome?: boolean;
}

const { isHome = true } = Astro.props;
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3.5 sm:px-6 sm:py-4">
		<a href={sectionHref("inicio")} class="shrink-0" aria-label="DM Integra, inicio">
			<img src={logo.src} alt="DM Integra" width="1559" height="326" class="h-6 w-auto sm:h-8" />
		</a>
		<nav aria-label="Navegación principal" class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
			<a href={sectionHref("inicio")} class="transition-colors hover:text-brand">Inicio</a>
			<a href={sectionHref("servicios")} class="transition-colors hover:text-brand">Servicios</a>
			<a href={sectionHref("proyectos")} class="transition-colors hover:text-brand">Proyectos</a>
			<a href={sectionHref("contacto")} class="transition-colors hover:text-brand">Contacto</a>
		</nav>
		<div class="flex shrink-0 items-center gap-2">
			<details data-mobile-menu class="relative md:hidden">
				<summary class="cursor-pointer list-none rounded-full border border-slate-200 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
					Menú
				</summary>
				<nav aria-label="Navegación móvil" class="absolute right-0 top-full z-10 mt-2 flex min-w-44 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-2 text-sm font-medium text-slate-700 shadow-lg">
					<a href={sectionHref("inicio")} class="rounded-lg px-3 py-2 hover:bg-slate-50">Inicio</a>
					<a href={sectionHref("servicios")} class="rounded-lg px-3 py-2 hover:bg-slate-50">Servicios</a>
					<a href={sectionHref("proyectos")} class="rounded-lg px-3 py-2 hover:bg-slate-50">Proyectos</a>
					<a href={sectionHref("contacto")} class="rounded-lg px-3 py-2 hover:bg-slate-50">Contacto</a>
				</nav>
			</details>
			<a
				href={contact.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Cuéntame tu proyecto por WhatsApp"
				class="inline-flex items-center justify-center rounded-full bg-brand px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:px-4"
			>
				<span class="sm:hidden">Hablemos</span>
				<span class="hidden sm:inline">Cuéntame tu proyecto</span>
			</a>
		</div>
	</div>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu.open = false;
		});
	});
</script>
