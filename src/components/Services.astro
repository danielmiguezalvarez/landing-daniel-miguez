---
const services = [
	{
		title: "Portales de Gestión y Reservas",
		description: "Tus clientes reservan, pagan y reciben su confirmación solos.",
		icon: "calendar",
	},
	{
		title: "Control de Accesos y Domótica",
		description: "Apertura de puertas, tornos y encendido de luces sincronizados con tus reservas.",
		icon: "access",
	},
	{
		title: "Software Interno a Medida",
		description: "Paneles sencillos para jubilar el papel y el Excel en tu operativa diaria.",
		icon: "panel",
	},
];
---

<section id="servicios" class="bg-slate-50">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
		<h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Servicios</h2>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
			Tres formas de quitarte trabajo repetitivo, sin cambiar cómo atiendes a tus clientes.
		</p>
		<ul class="mt-12 grid gap-5 md:grid-cols-3">
			{
				services.map((service) => (
					<li class="flex flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
						<span class="mb-6 flex size-11 items-center justify-center rounded-xl bg-petrol/10 text-petrol">
							{service.icon === "calendar" && (
								<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
									<rect x="3.5" y="5" width="17" height="15" rx="2" />
									<path d="M8 3.5v3M16 3.5v3M3.5 10h17" stroke-linecap="round" />
								</svg>
							)}
							{service.icon === "access" && (
								<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
									<circle cx="8" cy="8.5" r="3.25" />
									<path d="M10.4 10.8 19 19.2" stroke-linecap="round" />
									<path d="M15.2 16.6h2.6M16.6 18.2V20" stroke-linecap="round" />
								</svg>
							)}
							{service.icon === "panel" && (
								<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
									<rect x="3.5" y="4" width="17" height="16" rx="2" />
									<path d="M3.5 9h17M9 9v11" stroke-linecap="round" />
								</svg>
							)}
						</span>
						<h3 class="text-lg font-semibold tracking-tight text-slate-900">{service.title}</h3>
						<p class="mt-3 text-base leading-relaxed text-slate-600">{service.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
