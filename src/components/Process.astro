---
const steps = [
	{
		number: "01",
		title: "Contexto y objetivos",
		description: "Se entiende cómo funciona el negocio y qué merece la pena mejorar.",
	},
	{
		number: "02",
		title: "Propuesta y alcance",
		description: "Se define una solución adecuada, su alcance y los siguientes pasos.",
	},
	{
		number: "03",
		title: "Desarrollo y pruebas",
		description: "La solución se construye y se comprueba junto a quienes la utilizarán.",
	},
	{
		number: "04",
		title: "Puesta en marcha",
		description: "Se acompaña el inicio y se acuerda el soporte necesario.",
	},
];
---

<section id="proceso" class="bg-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
		<div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
			<div>
				<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">El proceso</p>
				<h2 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
					De la primera conversación a la puesta en marcha
				</h2>
			</div>
			<p class="max-w-2xl text-lg leading-relaxed text-slate-700 lg:justify-self-end">
				Un proceso directo, con decisiones compartidas y una solución ajustada a lo que necesitas.
			</p>
		</div>
		<ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step) => (
					<li class="border-t border-sage pt-5">
						<span class="font-sans text-4xl leading-none text-brand">{step.number}</span>
						<h3 class="mt-5 text-lg font-semibold text-slate-900">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
