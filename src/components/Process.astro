---
const steps = [
	{
		number: "01",
		title: "Escuchamos tu necesidad",
		description: "Hablamos de cómo trabajas y qué te gustaría mejorar, sin dar nada por supuesto.",
	},
	{
		number: "02",
		title: "Analizamos y proponemos",
		description: "Definimos una solución adecuada, su alcance y los siguientes pasos.",
	},
	{
		number: "03",
		title: "Desarrollamos y probamos",
		description: "Construimos la solución y comprobamos contigo que responde a lo acordado.",
	},
	{
		number: "04",
		title: "Entregamos y acompañamos",
		description: "Te ayudamos a ponerla en marcha y acordamos el soporte que necesites.",
	},
];
---

<section id="proceso" class="bg-slate-50">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
		<p class="text-sm font-medium tracking-wide text-brand">Cómo trabajamos</p>
		<h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
			Un proceso claro, de principio a fin
		</h2>
		<ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step) => (
					<li class="border-t border-slate-300 pt-5">
						<span class="text-sm font-semibold tracking-wide text-brand">{step.number}</span>
						<h3 class="mt-4 text-lg font-semibold text-slate-900">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
