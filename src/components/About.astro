<script>
	const portrait = document.querySelector<HTMLImageElement>("[data-portrait]");

	if (portrait) {
		const showFallback = () => portrait.classList.add("hidden");
		portrait.addEventListener("error", showFallback, { once: true });

		if (portrait.complete && portrait.naturalWidth === 0) {
			showFallback();
		}
	}
</script>

