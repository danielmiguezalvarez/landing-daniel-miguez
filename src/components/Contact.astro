---
import { contact } from "../data/contact";
---

<section id="contacto" class="scroll-mt-24 border-t border-slate-200/80 bg-white">
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-6 sm:py-28 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
		<div>
			<p class="text-sm font-medium tracking-wide text-brand">Contacto</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
				Cuéntame qué necesitas resolver
			</h2>
			<p class="mt-5 text-lg leading-relaxed text-slate-600">
				Si tienes una idea, un proceso que te quita tiempo o una duda técnica, podemos hablarlo sin compromiso.
			</p>
			<a
				href={contact.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M20.5 3.5A11 11 0 0 0 2.1 16.7L1 23l6.5-1.1A11 11 0 0 0 20.5 3.5Zm-8.5 17a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-3.9.6.7-3.8-.2-.3A9.1 9.1 0 1 1 12 20.5Zm5-6.8c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.2-.3a.5.5 0 0 0 0-.5c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4.1 5.3 5.3 0 0 0 3.2.7 2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.6-.3Z"></path>
				</svg>
				Escríbeme por WhatsApp
			</a>
			<p class="mt-3 text-sm text-slate-500">{contact.whatsappDisplayNumber}</p>
		</div>

		<div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
			<h3 class="text-lg font-semibold text-slate-900">Formulario de contacto</h3>
			<p id="formulario-descripcion" class="mt-2 text-sm leading-relaxed text-slate-600">
				Completa los campos para enviar tu consulta.
			</p>
			<p id="formulario-privacidad" class="mt-4 border-t border-slate-200 pt-3 text-xs leading-relaxed text-slate-500">
				<a href="/privacidad" class="font-medium text-slate-600 underline underline-offset-2 hover:text-brand">Información de privacidad</a>
			</p>
			<form
				id="contact-form"
				class="mt-4"
				action="https://api.web3forms.com/submit"
				method="POST"
				aria-describedby="formulario-descripcion formulario-privacidad"
			>
				<input
					type="hidden"
					name="access_key"
					value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? ""}
				/>
				<input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
				<fieldset class="grid gap-5 sm:grid-cols-2">
					<legend class="sr-only">Datos de contacto y proyecto</legend>
					<div>
						<label for="nombre" class="mb-1.5 block text-sm font-medium text-slate-700">Nombre</label>
						<input id="nombre" name="nombre" type="text" autocomplete="name" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-slate-100" />
					</div>
					<div>
						<label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">Email</label>
						<input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-slate-100" />
					</div>
					<div class="sm:col-span-2">
						<label for="tipo-proyecto" class="mb-1.5 block text-sm font-medium text-slate-700">Tipo de proyecto</label>
						<select id="tipo-proyecto" name="tipo-proyecto" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-slate-100">
							<option value="">Selecciona una opción</option>
							<option value="web">Desarrollo web</option>
							<option value="software">Software y automatización</option>
							<option value="iot">Hardware e IoT</option>
							<option value="otro">Otra necesidad</option>
						</select>
					</div>
					<div class="sm:col-span-2">
						<label for="descripcion" class="mb-1.5 block text-sm font-medium text-slate-700">¿Qué necesitas?</label>
						<textarea id="descripcion" name="descripcion" rows="4" required class="w-full resize-y rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-slate-100"></textarea>
					</div>
					<div class="sm:col-span-2">
						<button type="submit" class="rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50">Enviar consulta</button>
					</div>
				</fieldset>
			</form>
			<p id="contact-status" class="mt-4 text-sm text-slate-600" role="status" aria-live="polite" hidden></p>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const status = document.querySelector<HTMLParagraphElement>("#contact-status");
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	if (!form || !status || !submitButton) {
		throw new Error("No se pudo inicializar el formulario de contacto.");
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (form.dataset.submitting === "true" || !form.reportValidity()) {
			return;
		}

		const formData = new FormData(form);
		if (!formData.get("access_key")) {
			status.textContent = "El formulario no está configurado. Inténtalo de nuevo más tarde.";
			status.hidden = false;
			return;
		}

		form.dataset.submitting = "true";
		submitButton.disabled = true;
		status.textContent = "Enviando consulta…";
		status.hidden = false;

		try {
			const response = await fetch(form.action, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				body: JSON.stringify(Object.fromEntries(formData.entries())),
			});
			const result: unknown = await response.json();

			if (!response.ok || !isSuccessfulResponse(result)) {
				status.textContent =
					getResponseMessage(result) ?? "No se pudo enviar la consulta. Inténtalo de nuevo más tarde.";
				return;
			}

			form.reset();
			status.textContent = "Tu consulta se ha enviado correctamente.";
		} catch {
			status.textContent = "No se pudo enviar la consulta. Comprueba tu conexión e inténtalo de nuevo.";
		} finally {
			form.dataset.submitting = "false";
			submitButton.disabled = false;
		}
	});

	function isSuccessfulResponse(result: unknown): result is { success: true } {
		return typeof result === "object" && result !== null && "success" in result && result.success === true;
	}

	function getResponseMessage(result: unknown): string | undefined {
		if (typeof result !== "object" || result === null) {
			return undefined;
		}

		if ("message" in result && typeof result.message === "string") {
			return result.message;
		}

		if ("body" in result && typeof result.body === "object" && result.body !== null) {
			const body = result.body;
			if ("message" in body && typeof body.message === "string") {
				return body.message;
			}
		}

		return undefined;
	}
</script>
