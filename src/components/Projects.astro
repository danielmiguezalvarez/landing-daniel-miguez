---
const projects = [
	{
		title: "App-icultura",
		description:
			"Una aplicación propia para reunir el trabajo de campo, las tareas y los recursos de una explotación apícola.",
		image: "/projects/app-icultura/02-colmenar.png",
		imageAlt: "Vista de un colmenar con la distribución por filas y el estado de las colmenas",
		imageLabel: "Abrir la captura del colmenar a tamaño original en una pestaña nueva",
		imageWidth: 1440,
		imageHeight: 1117,
		href: "/proyectos/app-icultura",
		capabilities: ["Planificación de trabajo de campo", "Inventario y consumos", "Previsión de existencias"],
	},
	{
		title: "Amaruzen",
		description:
			"Una aplicación para coordinar salas, profesionales, clases, alumnos, reservas y cambios de sesión desde un calendario común.",
		image: "/projects/amaruzen/02-calendario-salas.png",
		imageAlt: "Calendario semanal de Amaruzen con clases y reservas distribuidas entre dos salas",
		imageLabel: "Abrir la captura del calendario de salas de Amaruzen a tamaño original en una pestaña nueva",
		imageWidth: 1440,
		imageHeight: 998,
		href: "/proyectos/amaruzen",
		capabilities: ["Calendario unificado", "Gestión de clases y alumnos", "Reservas y cambios"],
	},
];
---

<section id="proyectos" class="scroll-mt-24 border-t border-slate-200 bg-white">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
		<div class="max-w-2xl">
			<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">Proyectos</p>
			<h2 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
				Software pensado desde el trabajo real
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-slate-600">
				Dos ejemplos de cómo organizar mejor el trabajo, las personas y los recursos de un negocio.
			</p>
		</div>

		<div class="mt-12 grid gap-8 md:grid-cols-2">
			{
				projects.map((project) => (
					<article class="flex flex-col overflow-hidden border border-slate-200 bg-slate-100">
						<figure class="border-b border-slate-200 p-3 sm:p-4">
							<a href={project.image} target="_blank" rel="noopener noreferrer" aria-label={project.imageLabel}>
								<img
									src={project.image}
									alt={project.imageAlt}
									width={project.imageWidth}
									height={project.imageHeight}
									loading="lazy"
									decoding="async"
									class="block h-auto w-full border border-slate-200"
								/>
							</a>
							<figcaption class="flex flex-wrap items-center justify-between gap-2 px-2 pt-4 text-sm">
								<span class="text-slate-600">Captura real · datos ficticios</span>
								<a
									href={project.image}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={project.imageLabel}
									class="font-semibold text-slate-900 underline underline-offset-4 decoration-brand"
								>
									Abrir a tamaño original <span aria-hidden="true">↗</span>
								</a>
							</figcaption>
						</figure>

						<div class="flex flex-1 flex-col items-start p-6 sm:p-8">
							<p class="border-l-2 border-brand pl-3 text-sm font-semibold tracking-wide text-slate-900">Caso práctico</p>
							<h3 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">{project.title}</h3>
							<p class="mt-4 leading-relaxed text-slate-700">{project.description}</p>
							<ul class="mt-6 flex flex-wrap gap-2" aria-label="Capacidades destacadas">
								{project.capabilities.map((capability) => (
									<li class="border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700">
										{capability}
									</li>
								))}
							</ul>
							<div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-7">
								<a
									href={project.href}
									class="inline-flex items-center gap-2 border border-brand bg-brand px-5 py-3 text-sm font-semibold text-slate-900 transition-colors duration-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
								>
									Ver caso práctico <span aria-hidden="true">→</span>
								</a>
								<a href="#contacto" class="text-sm font-semibold text-slate-900 underline underline-offset-4 decoration-brand">
									Consultar un proyecto
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
