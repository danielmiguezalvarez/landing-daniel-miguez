---
import { whatsappUrl } from "../consts";
const linkedinUrl = "https://www.linkedin.com/";
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 sm:px-6 md:flex-row md:items-start md:justify-between">
		<div>
			<p class="text-sm font-semibold text-slate-900">Daniel Míguez · Sistemas &amp; Automatización</p>
			<p class="mt-2 text-sm text-slate-500">
				Software a medida y domótica para empresas, negocios y viviendas.
			</p>
		</div>
		<nav aria-label="Contacto" class="flex flex-col gap-3 text-sm">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex w-fit items-center gap-2 rounded-full bg-[#1FA855] px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#198C46] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#198C46]"
			>
				<svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z" />
				</svg>
				WhatsApp
			</a>
			<a
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="font-medium text-slate-700 underline-offset-4 hover:text-forest hover:underline"
			>
				LinkedIn
			</a>
		</nav>
		<nav aria-label="Legal" class="flex flex-col gap-3 text-sm">
			<a href="#aviso-legal" class="text-slate-500 underline-offset-4 hover:text-slate-900 hover:underline">
				Aviso Legal
			</a>
			<a href="#privacidad" class="text-slate-500 underline-offset-4 hover:text-slate-900 hover:underline">
				Política de Privacidad
			</a>
		</nav>
	</div>
	<div class="border-t border-slate-200">
		<p class="mx-auto max-w-6xl px-5 py-5 text-xs text-slate-500 sm:px-6">
			© {year} Daniel Míguez · Sistemas &amp; Automatización. Todos los derechos reservados.
		</p>
	</div>
</footer>
