---
import { contact } from "../data/contact";
import logo from "../assets/dm-integra-logo.png";
const year = new Date().getFullYear();

interface Props {
	isHome?: boolean;
}

const { isHome = true } = Astro.props;
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<footer class="border-t border-slate-200 bg-white">
	<div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<img src={logo.src} alt="DM Integra" width="1559" height="326" class="h-9 w-auto" />
			<p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-500">
				Desarrollo web, software y automatización para empresas y pequeños negocios.
			</p>
		</div>
		<nav aria-label="Navegación del pie de página" class="flex flex-col items-start gap-3 text-sm">
			<a href={sectionHref("servicios")} class="font-medium text-slate-700 underline-offset-4 hover:underline decoration-brand">Servicios</a>
			<a href={sectionHref("proyectos")} class="font-medium text-slate-700 underline-offset-4 hover:underline decoration-brand">Proyectos</a>
			<a href={sectionHref("sobre")} class="font-medium text-slate-700 underline-offset-4 hover:underline decoration-brand">Sobre DM Integra</a>
			<a href={sectionHref("contacto")} class="font-medium text-slate-700 underline-offset-4 hover:underline decoration-brand">Contacto</a>
		</nav>
		<div class="flex flex-col items-start gap-3 text-sm">
			<a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-slate-700 underline-offset-4 hover:underline decoration-brand">
				WhatsApp · {contact.whatsappDisplayNumber}
			</a>
			<a href="/aviso-legal" class="text-slate-500 underline-offset-4 hover:underline decoration-brand">Aviso legal</a>
			<a href="/privacidad" class="text-slate-500 underline-offset-4 hover:underline decoration-brand">Política de privacidad</a>
		</div>
	</div>
	<div class="border-t border-slate-200">
		<p class="mx-auto max-w-6xl px-5 py-5 text-xs text-slate-600 sm:px-6">
			© {year} · DM Integra
		</p>
	</div>
</footer>
